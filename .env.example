# Copie este arquivo para .env.production e preencha com suas chaves reais.
# O .env.production é ignorado pelo git (.gitignore).

# Frontend (Vite — lido em build time via import.meta.env)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Backend (Python — lido em /root/.hermes/secrets/leitor-supabase.env)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE=YOUR_SERVICE_ROLE_KEY_HERE
