# =====================================================
# Leitor Inteligente — Environment Variables (EXAMPLE)
# =====================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commit o .env real (já está no .gitignore).

# ----- Frontend (Vite — vars DEVEM começar com VITE_) -----
# URL do seu projeto Supabase (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon public key do Supabase (não é segredo, mas é identificador único)
# Pegue em: Supabase Dashboard > Project Settings > API > Project API keys > "anon public"
VITE_SUPABASE_ANON_KEY=

# URL opcional pro backend (padrão: https://pay.automacaojs.us)
VITE_PAYMENT_SERVER_URL=

# ----- Backend Python (payment_server.py) -----

# Porta onde o Flask roda (padrão: 3019)
PAYMENT_PORT=3019

# Supabase — pro webhook liberar ebooks na biblioteca
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# ----- Payment Provider (escolha UM) -----
# Prioridade: ASAAS_API_KEY > CAKTO_CLIENT_ID
# Pra integrar Mercado Pago no futuro, é só criar mercadopago.py + adicionar var aqui.

# Asaas (RECOMENDADO, gateway atual)
# Pegue em: https://app.asaas.com/ > Integrações > Token de API
ASAAS_API_KEY=

# Webhook token gerado pelo Asaas pro nosso endpoint
# Gerado automaticamente quando você cadastra o webhook via API/painel
ASAAS_WEBHOOK_TOKEN=

# Ambiente do Asaas: True= sandbox, False = produção
ASAAS_SANDBOX=true

# Cakto (BACKGROUND / legado, não use como primário)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# ----- Cloudflare Tunnel (config no /etc/cloudflared/config.yml) -----
# Domínio público do checkout: pay.automacaojs.us → http://localhost:3019

# ----- Google OAuth (login do Leitor) -----
# Configurado no Supabase Auth > Providers > Google
# Necessário: GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET cadastrados no Supabase
# (Não precisa dessas vars no .env se config no painel Supabase)
