# --- Node / Vite ---
node_modules/
dist/
.vite/
*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Env / Secrets ---
.env
.env.local
.env.*.local
*.pem
secrets/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# --- Build artifacts ---
*.tsbuildinfo
.cache/

# --- PDFs ---
# Exclui PDFs em data/ (são inputs locais de indexação)
data/*.pdf
data/*-raw.pdf
# Permite o livro principal em public/books/
!public/books/*.pdf

# --- Test artifacts ---
coverage/
*.lcov
playwright-report/
test-results/

# --- OS ---
.DS_Store
desktop.ini

# --- Backup files ---
*.bak
*.orig
*.rej


# --- JSONs de páginas indexadas (regeneráveis via api/build_index.py) ---
# São grandes e derivados dos PDFs. Não versionar.
data/*-pages.json
